<?xml version="1.0" encoding="utf-8"?>
<!-- The app's UI talks to its own proxy on 127.0.0.1 over plain HTTP (it
     never leaves the device); everything else must be HTTPS. The connection
     to the server is made by the Rust side, not by Android's network stack. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
