{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnimeWatcherPlus",
  "mainBinaryName": "animewatcherplus",
  "version": "0.3.0",
  "identifier": "com.animewatcherplus.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "AnimeWatcherPlus",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Video",
    "shortDescription": "Anime-Sammlung verwalten: fehlende Folgen, Wunschliste, Downloads",
    "longDescription": "Erkennt Animes in deinen Ordnern über AniDB, zeigt fehlende Folgen, sortiert und benennt Downloads und übergibt neue Folgen an deinen Download-Client -- lokal oder mit einem eigenen Server.",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/core"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNkQ3MDY0MDA1NzQ1NDYKUldSR1JWY0FaSEJ0ZS8wNzlzWmVZdklIVHpyV3Zuek1GUWR0VC9oRzBnYU8wamhhVGN4ZlV0Y0sK",
      "endpoints": [
        "https://github.com/LinkDarkshire/AnimeWatcherPlus/releases/latest/download/latest.json"
      ]
    }
  }
}
